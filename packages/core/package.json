{
  "name": "@reactre/core",
  "version": "0.0.2",
  "description": "A tiny, fast UI library: signals for state, compiled templates for the DOM.",
  "keywords": [
    "reactre",
    "ui",
    "dom",
    "signals",
    "reactive",
    "templates",
    "tsx",
    "jsx",
    "fine-grained"
  ],
  "homepage": "https://github.com/arafathusayn/reactre/tree/main/packages/core#readme",
  "bugs": "https://github.com/arafathusayn/reactre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafathusayn/reactre.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Arafat Husayn",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --format esm --packages external"
  },
  "dependencies": {
    "@reactre/dom": "workspace:*"
  }
}
