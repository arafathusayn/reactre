{
  "name": "@reactre/core",
  "version": "0.0.3",
  "description": "A tiny, fast UI library: signals for state, compiled templates for the DOM.",
  "keywords": [
    "reactre",
    "ui",
    "dom",
    "signals",
    "reactive",
    "templates",
    "tsx",
    "jsx",
    "fine-grained"
  ],
  "homepage": "https://github.com/arafathusayn/reactre/tree/main/packages/core#readme",
  "bugs": "https://github.com/arafathusayn/reactre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafathusayn/reactre.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Arafat Husayn",
  "type": "module",
  "sideEffects": [
    "./src/features/*.ts",
    "./dist/features/*.js"
  ],
  "exports": {
    ".": {
      "reactre-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "reactre-source": "./src/jsx-runtime.ts",
      "types": "./dist/jsx-runtime.d.ts",
      "bun": "./src/jsx-runtime.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "reactre-source": "./src/jsx-dev-runtime.ts",
      "types": "./dist/jsx-dev-runtime.d.ts",
      "bun": "./src/jsx-dev-runtime.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./features/*": {
      "reactre-source": "./src/features/*.ts",
      "types": "./dist/features/*.d.ts",
      "bun": "./src/features/*.ts",
      "default": "./dist/features/*.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/jsx-runtime.ts src/jsx-dev-runtime.ts src/features/selectors.ts src/features/owner.ts src/features/timing.ts src/features/reaction.ts src/features/dynamic.ts --outdir dist --target browser --format esm --packages external && bun ../../scripts/declarations.ts"
  },
  "dependencies": {
    "@reactre/dom": "workspace:*"
  }
}
