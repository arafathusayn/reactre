{
  "name": "@reactre/core",
  "version": "0.0.4",
  "description": "A tiny, fast UI library: signals for state, compiled templates for the DOM.",
  "keywords": [
    "reactre",
    "ui",
    "dom",
    "signals",
    "reactive",
    "templates",
    "tsx",
    "jsx",
    "fine-grained"
  ],
  "homepage": "https://github.com/arafathusayn/reactre/tree/main/packages/core#readme",
  "bugs": "https://github.com/arafathusayn/reactre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafathusayn/reactre.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Arafat Husayn",
  "type": "module",
  "sideEffects": [
    "./src/features/*.ts",
    "./dist/features/*.js",
    "./dist/dev/features/*.js",
    "./src/server/*.ts",
    "./dist/server/*.js",
    "./src/hydrate/*.ts",
    "./dist/hydrate/*.js"
  ],
  "exports": {
    ".": {
      "reactre-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "reactre-async": "./dist/async/index.js",
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "reactre-source": "./src/jsx-runtime.ts",
      "types": "./dist/jsx-runtime.d.ts",
      "bun": "./src/jsx-runtime.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "reactre-source": "./src/jsx-dev-runtime.ts",
      "types": "./dist/jsx-dev-runtime.d.ts",
      "bun": "./src/jsx-dev-runtime.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./features/memo": {
      "reactre-source": "./src/features/memo.ts",
      "types": "./dist/features/memo.d.ts",
      "bun": "./src/features/memo.ts",
      "development": "./dist/dev/features/memo.js",
      "default": "./dist/features/memo.js"
    },
    "./features/owner": {
      "reactre-source": "./src/features/owner.ts",
      "types": "./dist/features/owner.d.ts",
      "bun": "./src/features/owner.ts",
      "development": "./dist/dev/features/owner.js",
      "default": "./dist/features/owner.js"
    },
    "./features/context": {
      "reactre-source": "./src/features/context.ts",
      "types": "./dist/features/context.d.ts",
      "bun": "./src/features/context.ts",
      "development": "./dist/dev/features/context.js",
      "default": "./dist/features/context.js"
    },
    "./features/errors": {
      "reactre-source": "./src/features/errors.ts",
      "types": "./dist/features/errors.d.ts",
      "bun": "./src/features/errors.ts",
      "development": "./dist/dev/features/errors.js",
      "default": "./dist/features/errors.js"
    },
    "./features/timing": {
      "reactre-source": "./src/features/timing.ts",
      "types": "./dist/features/timing.d.ts",
      "bun": "./src/features/timing.ts",
      "development": "./dist/dev/features/timing.js",
      "default": "./dist/features/timing.js"
    },
    "./features/reaction": {
      "reactre-source": "./src/features/reaction.ts",
      "types": "./dist/features/reaction.d.ts",
      "bun": "./src/features/reaction.ts",
      "development": "./dist/dev/features/reaction.js",
      "default": "./dist/features/reaction.js"
    },
    "./features/effects": {
      "reactre-source": "./src/features/effects.ts",
      "types": "./dist/features/effects.d.ts",
      "bun": "./src/features/effects.ts",
      "development": "./dist/dev/features/effects.js",
      "default": "./dist/features/effects.js"
    },
    "./features/hydrate": {
      "reactre-source": "./src/features/hydrate.ts",
      "types": "./dist/features/hydrate.d.ts",
      "bun": "./src/features/hydrate.ts",
      "development": "./dist/dev/features/hydrate.js",
      "default": "./dist/features/hydrate.js"
    },
    "./hydrate/*": {
      "reactre-source": "./src/hydrate/*.ts",
      "types": "./dist/hydrate/*.d.ts",
      "bun": "./src/hydrate/*.ts",
      "default": "./dist/hydrate/*.js"
    },
    "./features/*": {
      "reactre-source": "./src/features/*.ts",
      "types": "./dist/features/*.d.ts",
      "bun": "./src/features/*.ts",
      "default": "./dist/features/*.js"
    },
    "./server": {
      "reactre-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "workerd": "./dist/server.js",
      "edge-light": "./dist/server.js",
      "worker": "./dist/server.js",
      "deno": "./dist/server.js",
      "browser": "./dist/server.browser.js",
      "bun": "./src/server.ts",
      "development": "./dist/dev/server.js",
      "default": "./dist/server.js"
    },
    "./server/*": {
      "reactre-source": "./src/server/*.ts",
      "types": "./dist/server/*.d.ts",
      "bun": "./src/server/*.ts",
      "default": "./dist/server/*.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts && bun ../../scripts/declarations.ts"
  },
  "dependencies": {
    "@reactre/dom": "workspace:*"
  }
}
