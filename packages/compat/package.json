{
  "name": "@reactre/compat",
  "version": "0.0.2",
  "description": "React 19's API on reactre's templates: alias react and react-dom to it and a React app runs unchanged.",
  "keywords": [
    "reactre",
    "react",
    "react-dom",
    "compat",
    "jsx",
    "templates"
  ],
  "homepage": "https://github.com/arafathusayn/reactre/tree/main/packages/compat#readme",
  "bugs": "https://github.com/arafathusayn/reactre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafathusayn/reactre.git",
    "directory": "packages/compat"
  },
  "license": "Apache-2.0",
  "author": "Arafat Husayn",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/features/*.ts",
    "./dist/index.js",
    "./dist/features/*.js",
    "./dist/chunk-*.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core.ts",
      "bun": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./classes": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./features/*": {
      "types": "./src/features/*.ts",
      "bun": "./src/features/*.ts",
      "default": "./dist/features/*.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "workerd": "./dist/server.edge.js",
      "edge-light": "./dist/server.edge.js",
      "worker": "./dist/server.browser.js",
      "browser": "./dist/server.browser.js",
      "bun": "./src/server.edge.ts",
      "default": "./dist/server.js"
    },
    "./static": {
      "types": "./src/server.ts",
      "workerd": "./dist/server.edge.js",
      "edge-light": "./dist/server.edge.js",
      "deno": "./dist/server.browser.js",
      "worker": "./dist/server.browser.js",
      "browser": "./dist/server.browser.js",
      "bun": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./server.node": {
      "types": "./src/server.ts",
      "bun": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./server.browser": {
      "types": "./src/server.browser.ts",
      "bun": "./src/server.browser.ts",
      "default": "./dist/server.browser.js"
    },
    "./server.edge": {
      "types": "./src/server.edge.ts",
      "bun": "./src/server.edge.ts",
      "default": "./dist/server.edge.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "bun": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./compiler": {
      "types": "./src/compiler.ts",
      "bun": "./src/compiler.ts",
      "default": "./dist/compiler.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/core.ts src/server.ts src/server.browser.ts src/server.edge.ts src/features/classes.ts src/features/stacks.ts src/features/keys.ts src/features/retry.ts src/features/concurrent.ts src/features/viewTransitions.ts src/features/undo.ts --outdir dist --target browser --format esm --splitting --chunk-naming \"chunk-[hash].[ext]\" --root src --packages external && bun build src/compiler.ts src/api.ts --outdir dist --target node --format esm --packages external"
  },
  "dependencies": {
    "@reactre/compiler": "workspace:*",
    "@reactre/dom": "workspace:*"
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
