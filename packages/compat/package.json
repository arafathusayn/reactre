{
  "name": "@reactre/compat",
  "version": "0.0.2",
  "description": "React 19's API on reactre's templates: alias react and react-dom to it and a React app runs unchanged.",
  "keywords": [
    "reactre",
    "react",
    "react-dom",
    "compat",
    "jsx",
    "templates"
  ],
  "homepage": "https://github.com/arafathusayn/reactre/tree/main/packages/compat#readme",
  "bugs": "https://github.com/arafathusayn/reactre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafathusayn/reactre.git",
    "directory": "packages/compat"
  },
  "license": "Apache-2.0",
  "author": "Arafat Husayn",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/features/*.ts",
    "./dist/index.js",
    "./dist/features/*.js",
    "./dist/chunk-*.js",
    "./dist/dev/index.js",
    "./dist/dev/features/*.js",
    "./dist/dev/chunk-*.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core.ts",
      "bun": "./src/core.ts",
      "development": "./dist/dev/core.js",
      "default": "./dist/core.js"
    },
    "./classes": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./features/*": {
      "types": "./src/features/*.ts",
      "bun": "./src/features/*.ts",
      "development": "./dist/dev/features/*.js",
      "default": "./dist/features/*.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "workerd": {
        "development": "./dist/dev/server.edge.js",
        "default": "./dist/server.edge.js"
      },
      "edge-light": {
        "development": "./dist/dev/server.edge.js",
        "default": "./dist/server.edge.js"
      },
      "worker": {
        "development": "./dist/dev/server.browser.js",
        "default": "./dist/server.browser.js"
      },
      "browser": {
        "development": "./dist/dev/server.browser.js",
        "default": "./dist/server.browser.js"
      },
      "bun": "./src/server.edge.ts",
      "default": {
        "development": "./dist/dev/server.js",
        "default": "./dist/server.js"
      }
    },
    "./static": {
      "types": "./src/server.ts",
      "workerd": {
        "development": "./dist/dev/server.edge.js",
        "default": "./dist/server.edge.js"
      },
      "edge-light": {
        "development": "./dist/dev/server.edge.js",
        "default": "./dist/server.edge.js"
      },
      "deno": {
        "development": "./dist/dev/server.browser.js",
        "default": "./dist/server.browser.js"
      },
      "worker": {
        "development": "./dist/dev/server.browser.js",
        "default": "./dist/server.browser.js"
      },
      "browser": {
        "development": "./dist/dev/server.browser.js",
        "default": "./dist/server.browser.js"
      },
      "bun": "./src/server.ts",
      "default": {
        "development": "./dist/dev/server.js",
        "default": "./dist/server.js"
      }
    },
    "./server.node": {
      "types": "./src/server.ts",
      "bun": "./src/server.ts",
      "default": {
        "development": "./dist/dev/server.js",
        "default": "./dist/server.js"
      }
    },
    "./server.browser": {
      "types": "./src/server.browser.ts",
      "bun": "./src/server.browser.ts",
      "default": {
        "development": "./dist/dev/server.browser.js",
        "default": "./dist/server.browser.js"
      }
    },
    "./server.edge": {
      "types": "./src/server.edge.ts",
      "bun": "./src/server.edge.ts",
      "default": {
        "development": "./dist/dev/server.edge.js",
        "default": "./dist/server.edge.js"
      }
    },
    "./api": {
      "types": "./src/api.ts",
      "bun": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./compiler": {
      "types": "./src/compiler.ts",
      "bun": "./src/compiler.ts",
      "default": "./dist/compiler.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts"
  },
  "dependencies": {
    "@reactre/compiler": "workspace:*",
    "@reactre/dom": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
