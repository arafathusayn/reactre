{
  "name": "reactre",
  "version": "0.0.1",
  "description": "A tiny, fast UI library: signals for state, compiled templates for the DOM.",
  "keywords": [
    "ui",
    "dom",
    "signals",
    "reactive",
    "templates",
    "tsx",
    "jsx",
    "keyed-list",
    "fine-grained"
  ],
  "homepage": "https://github.com/arafathusayn/reactre/tree/main/packages/reactre#readme",
  "bugs": "https://github.com/arafathusayn/reactre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafathusayn/reactre.git",
    "directory": "packages/reactre"
  },
  "license": "Apache-2.0",
  "author": "Arafat Husayn",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./src/dom.ts",
      "bun": "./src/dom.ts",
      "default": "./dist/dom.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/dom.ts --outdir dist --target browser --format esm --splitting --packages external"
  }
}
