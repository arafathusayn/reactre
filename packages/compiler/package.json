{
  "name": "@reactre/compiler",
  "version": "0.0.3",
  "description": "The Bun plugin that compiles reactre TSX into templates and the code that updates them.",
  "keywords": [
    "reactre",
    "bun",
    "bun-plugin",
    "tsx",
    "jsx",
    "compiler",
    "templates"
  ],
  "homepage": "https://github.com/arafathusayn/reactre/tree/main/packages/compiler#readme",
  "bugs": "https://github.com/arafathusayn/reactre/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arafathusayn/reactre.git",
    "directory": "packages/compiler"
  },
  "license": "Apache-2.0",
  "author": "Arafat Husayn",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "reactre-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./map": {
      "reactre-source": "./src/map.ts",
      "types": "./dist/map.d.ts",
      "bun": "./src/map.ts",
      "default": "./dist/map.js"
    },
    "./program": {
      "reactre-source": "./src/program.ts",
      "types": "./dist/program.d.ts",
      "bun": "./src/program.ts",
      "default": "./dist/program.js"
    },
    "./scan": {
      "reactre-source": "./src/scan.ts",
      "types": "./dist/scan.d.ts",
      "bun": "./src/scan.ts",
      "default": "./dist/scan.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/map.ts src/program.ts src/scan.ts --outdir dist --target node --format esm --splitting --packages external && bun ../../scripts/declarations.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
