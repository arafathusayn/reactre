{
  "name": "reactre-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "bun-types": "1.4.4",
      "puppeteer-core": "25.16.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@radix-ui/react-dialog": "1.3.1",
      "@tanstack/react-query": "5.105.0",
      "framer-motion": "14.7.1",
      "lucide-react": "1.62.0",
      "react-hook-form": "7.91.0",
      "react-router": "8.5.1",
      "react-transition-group": "4.4.5",
      "recharts": "3.10.1",
      "sonner": "2.0.8",
      "zustand": "5.0.16"
    }
  },
  "scripts": {
    "check:strict": "bun check -p tsconfig.strict.json",
    "compat": "bun --cwd apps/react-compat run.ts"
  },
  "devDependencies": {
    "@reactre/compiler": "workspace:*",
    "@reactre/testdom": "workspace:*",
    "bun-types": "catalog:"
  }
}
