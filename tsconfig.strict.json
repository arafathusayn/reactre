{
  // The strictest settings, for the published packages, on top of tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedDeclarations": true,
    "declaration": true,
    "erasableSyntaxOnly": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "strictBuiltinIteratorReturn": true,
    "moduleDetection": "force",
    "forceConsistentCasingInFileNames": true,
    "libReplacement": false
  },
  // @reactre/state publishes its compiler, plugin and codemod beside src/.
  "include": ["packages/*/src", "packages/state/compiler", "packages/state/plugin", "packages/state/codemod"]
}
